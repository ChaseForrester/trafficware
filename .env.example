# Server only. Never prefix this with VITE_ — that would put the key in the browser bundle.
XAI_API_KEY=

# Optional. If set, the app asks for this code before it will call Grok.
# The same code opens the shared Firestore yard. Use it on the public internet.
TRAFFICWARE_PIN=

# Firebase admin key for project trafficware-yard, base64 of the JSON file.
# Server only. The browser never receives this. Rules deny direct client access.
FIREBASE_SERVICE_ACCOUNT_B64=

# Public web API key for email sign-in on trafficware-yard. Safe in the browser.
# It cannot read Firestore. Vite inlines it at build time.
VITE_FIREBASE_API_KEY=

# Xero web app. Create it at https://developer.xero.com/app/manage
# Redirect URI: https://trafficware.vercel.app/api/xero-callback
# Scopes: offline_access accounting.invoices accounting.contacts
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional. A sales account code from the organisation's chart. Leave blank to omit it.
XERO_SALES_ACCOUNT=
# Optional. Defaults to https://<this host>/api/xero-callback
XERO_REDIRECT_URI=
